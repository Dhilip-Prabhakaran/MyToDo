# Copy to .env for local overrides (optional). .env is gitignored.
#
# Leave MONGODB_URI blank to use the local JSON file at server/data/db.json.
# Set it to a MongoDB connection string (e.g. MongoDB Atlas) for durable,
# deploy-surviving storage:
#   MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=mytodo
